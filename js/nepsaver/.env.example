# Copy to .env and fill in. Never commit .env.
# From https://developer.spotify.com/dashboard -> your app -> Settings
CLIENT_ID=
CLIENT_SECRET=
# Must be listed exactly as "Redirect URI" in the Spotify app settings
REDIRECT_URL=http://localhost:5000/callback
# Target playlist: the part after /playlist/ in its share link (can also be entered on the home page)
PLAYLIST_ID=
# PORT=5000
